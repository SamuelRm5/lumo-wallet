# Variables leídas y validadas en src/config/env.js al arrancar.
# Si falta una obligatoria el proceso no arranca.

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

APP_TIMEZONE=America/Bogota
APP_CURRENCY=COP

# Obligatoria. Sin ella el proceso no arranca
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=90

CORS_ORIGIN=http://localhost:5173

# Cerrado por defecto. Se abre solo para dar de alta a un usuario nuevo
ALLOW_PUBLIC_REGISTRATION=false
RATE_LIMIT_AUTH_WINDOW_MIN=15
RATE_LIMIT_AUTH_MAX=10

# Job de recurrentes. Se apaga sin tocar el resto de la aplicación
RECURRING_JOB_ENABLED=true
RECURRING_JOB_CRON=0 6 * * *
RECURRING_MAX_CATCHUP=12

# La app no registra dispositivos desde que el push salió de su alcance, así
# que hoy no hay a quién notificar. Sin token el envío se salta y queda en el log
EXPO_ACCESS_TOKEN=

# Vacía significa que no se rechaza ninguna versión del cliente
MIN_CLIENT_VERSION=

# Obligatoria. La usan el servidor y el CLI de Prisma
DATABASE_URL="mysql://usuario:password@localhost:3306/lumo-wallet"
