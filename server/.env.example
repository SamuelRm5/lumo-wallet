# Variables leídas y validadas en src/config/env.js al arrancar.
# Si falta una obligatoria el proceso no arranca.

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

APP_TIMEZONE=America/Bogota
APP_CURRENCY=COP

# Obligatoria. Sin ella el proceso no arranca
JWT_SECRET=

CORS_ORIGIN=http://localhost:5173

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_DIALECT=mysql
